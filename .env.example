# Sentry — error monitoring
# Create a project at https://sentry.teritorio.xyz and fill in the values below.
# DSN is public (baked into the client bundle at build time).
NUXT_PUBLIC_SENTRY_DSN=

# Sentry source maps upload (build-time only, never exposed to the client)
SENTRY_URL=https://sentry.teritorio.xyz/
SENTRY_ORG=teritorio
SENTRY_PROJECT=cartoguide-website
SENTRY_AUTH_TOKEN=

# Matomo — analytics
# Set to the Matomo site ID for CartoGuide on https://matomo.teritorio.xyz
NUXT_PUBLIC_MATOMO_SITE_ID=
