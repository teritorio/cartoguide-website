{
  "name": "CartoGuide",
  "short_name": "CartoGuide",
  "description": "Aplicación web cartográfica open source basada en OpenStreetMap",
  "lang": "es",
  "start_url": "/es/",
  "display": "browser",
  "background_color": "#ffffff",
  "theme_color": "#1F71B8",
  "icons": [
    {
      "src": "/favicon.svg",
      "type": "image/svg+xml",
      "sizes": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "type": "image/png",
      "sizes": "180x180"
    }
  ]
}
